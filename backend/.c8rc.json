{
  "all": true,
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/main.ts",
    "src/**/*.module.ts",
    "src/**/*.dto.ts",
    "src/generated/**"
  ],
  "extension": [".ts"],
  "reporter": ["text", "html", "lcov"],
  "check-coverage": true,
  "branches": 70,
  "lines": 70,
  "functions": 70,
  "statements": 70
}
