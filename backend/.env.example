PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ---- Database (Neon Postgres) ----
# DATABASE_URL: the POOLED connection (hostname has "-pooler" in it).
DATABASE_URL="postgresql://<user>:<password>@<neon-host>-pooler/<db>?sslmode=verify-full"
# DIRECT_URL: the DIRECT (unpooled) connection.
DIRECT_URL="postgresql://<user>:<password>@<neon-host>/<db>?sslmode=verify-full"

JWT_ACCESS_SECRET=replace-me-with-a-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-me-with-a-random-string
JWT_REFRESH_EXPIRES_IN=7d
PASSWORD_RESET_TOKEN_EXPIRES_IN=30m

LOG_LEVEL=debug